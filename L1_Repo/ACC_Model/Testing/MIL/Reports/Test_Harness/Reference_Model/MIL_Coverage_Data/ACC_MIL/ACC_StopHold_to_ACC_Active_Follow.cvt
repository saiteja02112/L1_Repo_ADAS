  codeblock {
    id			    275
    slsfobj		    15
    code		    "ACC_States\nACC_Req =  fcn_calc_Acc_Req(ACC_Status,V_Lead,V_ego,V_set,Standstill_Dist,Safety_Time_Gap,D"
    "ist_Rel)\nHMI_Bar = uint8(HMI_Distance_Bars())"
  }
  codeblock {
    id			    276
    slsfobj		    16
    code		    "ACC_Active\nen:\nACC_Status = 3;\nACC_State = ACC_Active;\nAcceleration_Request = ACC_Req;\n%Vset-Vego\n"
    "Torque_Request_Status = Longi;\nHMI_ACC_ICON = Green;\nHMI_SetSpeed = V_set;%Current_SetSpeed\nAudible_Warning = W"
    "arn_Single_Beep;\nInternal_Control_Mode = Speedctrl;"
  }
  codeblock {
    id			    277
    slsfobj		    17
    code		    "ACC_Active_Follow\nen:\nACC_Status = 4;\nACC_State =  ACC_Active_Follow;\nAcceleration_Request = ACC_Re"
    "q;\n%Drel Cal\nTorque_Request_Status = Dis_active;\nHMI_ACC_ICON = Green;\nHMI_SetSpeed = V_set;%New_SetSpeed_Targ"
    "et\nHMI_Distance = HMI_Bar;%1-5 Bars\nAudible_Warning = Warn_None;\nInternal_Control_Mode = Distctrl;\n"
  }
  codeblock {
    id			    278
    slsfobj		    18
    code		    "ACC_Fault \nen:\nACC_Status = 2;\nACC_State = ACC_Fault;\nAcceleration_Request = ACC_Req;%Rampto0\nTorq"
    "ue_Request_Status = Fault;\nHMI_ACC_ICON = Red;\nAudible_Warning = Warn_Loud_Chime;\nInternal_Control_Mode = Error"
    ";"
  }
  codeblock {
    id			    279
    slsfobj		    19
    code		    "ACC_Off\nen:\nACC_Status = 0;\nACC_State = ACC_Off;\nAcceleration_Request = ACC_Req;\nTorque_Request_St"
    "atus = Disabled;\nHMI_ACC_ICON = Off;\nHMI_SetSpeed = 0;\nAudible_Warning = Warn_None;\nInternal_Control_Mode = St"
    "andstill;\n"
  }
  codeblock {
    id			    280
    slsfobj		    20
    code		    "ACC_Override\nen:\nACC_Status = 6;\nACC_State = ACC_Override;\nAcceleration_Request = ACC_Req;\nTorque_"
    "Request_Status = Override;\nHMI_ACC_ICON = Blink_Green;\nAudible_Warning = Warn_Chime;%V>Vset for x\nInternal_Cont"
    "rol_Mode = Passive;"
  }
  codeblock {
    id			    281
    slsfobj		    21
    code		    "ACC_Standby\nen:\nACC_Status = 1;\nACC_State = ACC_Standby;\nAcceleration_Request = ACC_Req;\nTorque_Re"
    "quest_Status = Standby;\nHMI_ACC_ICON = White;\nHMI_SetSpeed = V_set;%Prev Speed\nAudible_Warning = Warn_None;\nIn"
    "ternal_Control_Mode = Monitoring;"
  }
  codeblock {
    id			    282
    slsfobj		    22
    code		    "ACC_Stop_Hold\nen:\nACC_Status = 5;\nACC_State = ACC_Stop_Hold;\nAcceleration_Request = ACC_Req;\nTorqu"
    "e_Request_Status = Hold_Req;\nHMI_ACC_ICON = Green;\nAudible_Warning = Warn_None;\nInternal_Control_Mode = Standst"
    "ill;"
  }
